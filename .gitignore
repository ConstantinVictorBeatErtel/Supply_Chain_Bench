# Bulky / regenerable experiment dumps — keep compact published boards only
artifacts/runs/
artifacts/diagnostics/
artifacts/serial_claude_opus_5_efficient_v5/
artifacts/frontier_t5_y_36w_20260802/episodes/
artifacts/frontier_t5_y_36w_20260802/raw/
artifacts/live_y_domain_randomized_grpo_v1/runpod_*/adapter/
artifacts/live_y_qwen35_4b_rl/claude_opus_5_efficient/
artifacts/hub_llm/**/traces.jsonl
artifacts/hub_llm/**/config.toml
artifacts/**/*.csv

# In-flight eval scratch: partial dumps, backups, PIDs and agent handoff notes.
# The finished results JSON next to them is what stays in git.
artifacts/**/*.partial_from_log.json
artifacts/**/*.bak
artifacts/**/*.pid
artifacts/**/COORDINATION.md
artifacts/**/*HANDOFF*.txt
artifacts/**/*STATUS*.txt

# Local web checkpoints may still ship with the FastAPI UI
!beer_distribution_rl/web/assets/
!beer_distribution_rl/web/assets/**/
!beer_distribution_rl/web/assets/**/*.pt
!beer_distribution_rl/web/assets/**/*.pth

# Never let credential material into the tree (a sync bug once copied an SSH
# private key into artifacts/; see scripts/sync_runpod_artifacts.sh).
*.pem
*ssh-key*
id_rsa*
id_ed25519*

# LoRA adapters and per-update checkpoints are large binaries; the selected
# adapter is published to the Hugging Face Hub instead (see the postmortem).
# Metrics, rollouts and manifests stay in git; weights do not.
artifacts/**/adapter_model.safetensors
artifacts/**/checkpoints/update_*/
artifacts/live_y_best_adapter*/tokenizer.json
